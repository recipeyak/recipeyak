DEBUG=1
DJANGO_SECRET_KEY=
DATABASE_URL=postgres://postgres@localhost:5432/recipeyak

EMAIL_HOST=smtp.mailgun.org
EMAIL_HOST_USER=server@example.com
EMAIL_HOST_PASSWORD=

POSTGRES_BACKUP_S3_BUCKET=recipeyak-backups

# Local dev uses the fake S3 from docker-compose-dev.yml. In production, set
# real AWS keys and remove AWS_ENDPOINT_URL and STORAGE_URL.
AWS_ACCESS_KEY_ID=fake
AWS_SECRET_ACCESS_KEY=fake
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:9090

STORAGE_BUCKET_NAME=recipeyak-production
STORAGE_HOSTNAME=images-cdn.recipeyak.com
STORAGE_URL=http://localhost:9090/recipeyak-production

SENTRY_DSN=
SENTRY_ENVIRONMENT=local

ABLY_API_KEY=

ALGOLIA_APPLICATION_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SEARCH_ONLY_API_KEY=

# Cloudflare test secret that accepts any token
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
