    image_urls=list([
      'https://static01.nyt.com/images/2024/07/03/multimedia/03apperex1-smores-cgjl/MC-Shortcut-Oven-SMoresrex-cgjl-threeByTwoMediumAt2X.jpg',
      'https://static01.nyt.com/images/2024/07/03/multimedia/03apperex1-smores-cgjl/MC-Shortcut-Oven-SMoresrex-cgjl-mediumSquareAt3X.jpg',
    ]),
