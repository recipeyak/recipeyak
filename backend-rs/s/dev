#!/usr/bin/env bash
set -ex

# share Django's database so its sessions work here
set -a
# shellcheck source=/dev/null
source ../backend/.env
set +a
export RECIPEYAK_RS_DATABASE_URL="$DATABASE_URL"
export RECIPEYAK_RS_STORAGE_HOSTNAME="$STORAGE_HOSTNAME"
export RECIPEYAK_RS_STORAGE_BUCKET_NAME="$STORAGE_BUCKET_NAME"
export RECIPEYAK_RS_AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
export RECIPEYAK_RS_AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
export RECIPEYAK_RS_ABLY_API_KEY="${ABLY_API_KEY:-}"

cargo run "$@"
