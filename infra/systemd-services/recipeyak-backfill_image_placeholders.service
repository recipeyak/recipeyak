[Unit]
Description=Runs backfill_image_placeholders job
[Service]
ExecStartPre=-/usr/bin/docker rm -f backfill_image_placeholders
ExecStart=/usr/bin/docker run \
        --rm \
        --network host \
        --log-driver=journald \
        --env-file=/root/.env-production \
        --name backfill_image_placeholders \
        recipeyak/django:{{GIT_SHA}} \
        ./.venv/bin/python -m recipeyak.jobs.backfill_image_placeholders --no-dry-run
ExecStopPost=-/usr/bin/docker rm -f backfill_image_placeholders
KillSignal=SIGINT
# TimeoutSec only bounds startup and shutdown; RuntimeMaxSec is what
# kills a job that hangs while running.
RuntimeMaxSec=600
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
