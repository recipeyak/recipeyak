[Unit]
Description=Runs remove_old_checklists job
[Service]
ExecStartPre=-/usr/bin/docker rm -f remove_old_checklists
ExecStart=/usr/bin/docker run \
        --rm \
        --network host \
        --log-driver=journald \
        --name remove_old_checklists \
        --env-file=/root/.env-production \
        recipeyak/django:{{GIT_SHA}} \
        ./.venv/bin/python -m recipeyak.jobs.remove_old_checklists
ExecStopPost=-/usr/bin/docker rm -f remove_old_checklists
KillSignal=SIGINT
# TimeoutSec only bounds startup and shutdown; RuntimeMaxSec is what
# kills a job that hangs while running.
RuntimeMaxSec=600
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
