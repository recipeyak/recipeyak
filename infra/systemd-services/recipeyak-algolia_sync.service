[Unit]
Description=Runs algolia sync job once
[Service]
ExecStartPre=-/usr/bin/docker rm -f live_search_sync_one_off
ExecStart=/usr/bin/docker run \
        --rm \
        --network host \
        --log-driver=journald \
        --env-file=/root/.env-production \
        --name live_search_sync_one_off \
        recipeyak/django:{{GIT_SHA}} \
        ./.venv/bin/python -m recipeyak.jobs.live_search_sync --backfill-all
ExecStopPost=-/usr/bin/docker rm -f live_search_sync_one_off
KillSignal=SIGINT
# TimeoutSec only bounds startup and shutdown; RuntimeMaxSec is what
# kills a job that hangs while running.
RuntimeMaxSec=120
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
